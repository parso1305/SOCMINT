# SOCMINT-India settings. Copy to .env (`socmint init-db` does this for you and generates secrets).

# --- Required for polite HTTP (sent in the User-Agent to every public source) ---
CONTACT_EMAIL=

# --- Privacy (generated automatically by `socmint init-db` if .env does not exist) ---
PRIVACY_SALT=
RETENTION_DAYS=7

# --- Local API key for GET /alerts and /narratives (header: X-API-Key) ---
SOCMINT_API_KEY=

# --- Storage (default: sqlite file in ./data) ---
# SOCMINT_DB_URL=sqlite:///data/socmint.db

# --- Embeddings: auto | e5 | tfidf ---
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=intfloat/multilingual-e5-small
WHISPER_MODEL=small

# --- Free-key sources (each source is enabled only when its key is present) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
YOUTUBE_API_KEY=
GOOGLE_FACTCHECK_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GOOGLE_SAFE_BROWSING_KEY=
URLHAUS_AUTH_KEY=

# --- Bluesky logged-in search (optional; without it Bluesky events use a 60 s Jetstream live listen) ---
# Use a dedicated project account, never a personal one.
# Use an APP PASSWORD (bsky.app: Settings -> Privacy and security -> App passwords), never the account password.
# Do not give the app password DM access. The session is cached in data/cache/bluesky_session.json (git-ignored).
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
